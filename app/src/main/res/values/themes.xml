<resources>
    <style name="Theme.FileServerClient" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <item name="colorSecondary">#03DAC5</item>
        <item name="colorSecondaryVariant">#018786</item>
        <item name="colorOnSecondary">@android:color/black</item>

        <!-- 表面和窗口背景全部透明 -->
        <item name="colorSurface">@android:color/transparent</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@android:color/transparent</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:actionMenuTextColor">?attr/colorOnSurface</item>
    </style>
</resources>