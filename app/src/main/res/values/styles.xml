<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. 改为 DayNight，支持深色模式 -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="CardViewStyle" parent="CardView">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
    </style>

    <style name="PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/primary_button_background</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/secondary_button_background</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="IconButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/icon_button_background</item>
        <item name="android:textColor">@color/primary_color</item>
    </style>
        <style name="ShapeAppearance.Rounded8" parent="">
            <item name="cornerFamily">rounded</item>
            <item name="cornerSize">8dp</item>
        </style>
</resources>