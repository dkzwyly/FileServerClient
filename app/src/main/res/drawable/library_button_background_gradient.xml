<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="@color/library_text_bg"
                android:endColor="@color/library_image_bg"
                android:angle="45" />
            <stroke
                android:width="1dp"
                android:color="@color/primary_blue" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="@color/surface"
                android:endColor="@color/background_light"
                android:angle="45" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>
</selector>