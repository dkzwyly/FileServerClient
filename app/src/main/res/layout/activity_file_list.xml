<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <!-- 顶部 Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:title="文件列表"
        app:titleTextColor="@android:color/white" />

    <!-- 搜索和操作栏（修改后：统一高度 48dp，优化内边距） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp">

                <EditText
                    android:id="@+id/searchEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="🔍 搜索文件"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    android:background="@null"
                    android:paddingVertical="8dp"
                    android:paddingStart="0dp"
                    android:maxLines="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/searchButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="搜索"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="13sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 选择模式按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectModeButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="选择"
            android:textSize="14sp"
            app:cornerRadius="28dp" />

        <!-- 上传按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectFilesButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="上传"
            android:textSize="14sp"
            android:layout_marginStart="8dp"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_attach_file"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

    </LinearLayout>

    <!-- 上传状态卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/uploadStatusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/selectedFilesLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未选择文件"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/uploadButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⬆️ 上传"
                android:textSize="14sp"
                app:cornerRadius="24dp"
                android:enabled="false" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- 文件列表卡片 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="?attr/colorSurface">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="文件列表"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/fileCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 个项目"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/filesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:padding="4dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/statusLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="就绪"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurface"
        android:padding="12dp" />

    <!-- 底部操作栏（选择模式） -->
    <LinearLayout
        android:id="@+id/selectionActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/selection_bar_background"
        android:elevation="8dp"
        android:padding="8dp"
        android:visibility="gone"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/selectedCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="已选 0 项"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/actionRename"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_rename"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="重命名"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/actionMove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_move"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="移动"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/actionCopy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_copy"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="复制"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/actionDelete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_delete_white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="删除"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/actionCancelSelection"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="取消选择"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- 新建文件夹 FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/createFolderButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add"
        app:tint="@android:color/white"
        app:backgroundTint="@color/primary_color" />

</LinearLayout>