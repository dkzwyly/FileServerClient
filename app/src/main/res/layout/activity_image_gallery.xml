<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:elevation="4dp">

        <!-- 返回按钮 -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/black"
            android:contentDescription="返回" />

        <!-- 标题居中 -->
        <TextView
            android:id="@+id/galleryTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="图片"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@android:color/black" />

        <!-- 右侧按钮容器 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- 排序按钮（仅相册Tab可见） -->
            <ImageButton
                android:id="@+id/sortButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_sort"
                app:tint="#333333"
                android:contentDescription="排序"
                android:layout_marginEnd="8dp"
                android:visibility="visible" />

            <!-- 相机按钮 -->
            <ImageButton
                android:id="@+id/cameraButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_camera"
                app:tint="#2196F3"
                android:contentDescription="相机"
                android:layout_marginEnd="8dp" />

            <!-- 上传按钮 -->
            <ImageButton
                android:id="@+id/reindexButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_upload"
                app:tint="#4CAF50"
                android:contentDescription="上传图片"
                android:layout_marginEnd="8dp" />

            <!-- 多选删除按钮（仅相册Tab可见） -->
            <ImageButton
                android:id="@+id/deleteSelectedButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                app:tint="#FF5252"
                android:contentDescription="删除选中"
                android:visibility="gone"
                android:enabled="false" />

        </LinearLayout>
    </LinearLayout>

    <!-- 多选状态栏（仅相册Tab可见） -->
    <LinearLayout
        android:id="@+id/selectionToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E8E8E8"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:elevation="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selectedCountText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="已选择 0 项"
            android:textSize="14sp"
            android:textColor="#333333"
            android:paddingStart="16dp" />

        <Button
            android:id="@+id/selectAllButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="全选"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackground"
            android:textColor="#2196F3" />

        <Button
            android:id="@+id/cancelSelectionButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="取消"
            android:textSize="14sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="?attr/selectableItemBackground"
            android:textColor="#666666"
            android:layout_marginStart="8dp" />

    </LinearLayout>

    <!-- Tab 切换栏 -->
    <LinearLayout
        android:id="@+id/tabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:padding="8dp">

        <TextView
            android:id="@+id/albumTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="相册"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/tab_background_selected"
            android:textColor="@color/primary_color"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/albumSetTab"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="相册集"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/tab_background"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 状态提示 -->
    <TextView
        android:id="@+id/galleryStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="正在加载..."
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center" />

    <!-- 相册图片网格（原功能） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/galleryRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="4dp"
        android:visibility="visible" />

    <!-- 相册集列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/albumSetRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:padding="8dp" />

    <!-- 新建相册 FAB（仅相册集Tab可见） -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addAlbumFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add"
        android:visibility="gone"
        app:tint="@android:color/white"
        app:backgroundTint="@color/primary_color" />

</LinearLayout>