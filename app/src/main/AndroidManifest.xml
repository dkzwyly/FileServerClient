<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========== 网络 ========== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ========== 相机 / 麦克风 / 前台服务 ========== -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ========== 存储：Android 13+ 用媒体权限 ========== -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- ========== 存储：Android 12 及以下用外部存储 ========== -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- ========== 硬件特性 ========== -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- ========== TTS 服务查询 ========== -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".MusicApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.FileServerClient"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- ========== 主入口 ========== -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ========== 文件浏览 ========== -->
        <activity
            android:name=".FileListActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar.OptOut" />
        <activity
            android:name=".DirectoryPickerActivity"
            android:label="选择目标文件夹"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar.OptOut" />
        <activity
            android:name=".SettingsActivity"
            android:label="设置"
            android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar.OptOut" />
        <activity
            android:name=".TaskListActivity"
            android:label="任务列表"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
        <activity
            android:name=".TrashActivity"
            android:theme="@style/Theme.FileServerClient"
            android:parentActivityName=".MainActivity" />

        <!-- ========== 图片 / 相册集 ========== -->
        <activity
            android:name=".ImageGalleryActivity"
            android:label="图片库"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AlbumDetailActivity"
            android:label="相册详情"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ImagePickerActivity"
            android:label="选择图片"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut" />
        <activity
            android:name=".ImageActivity"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut" />
        <activity
            android:name=".GalleryVideoPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="sensor"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity android:name=".SingleImageActivity" />

        <!-- 本地同步 -->
        <activity
            android:name=".sync.ImageSyncActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar" />

        <!-- ========== 文本 ========== -->
        <activity
            android:name=".TextPreviewActivity"
            android:label="文本预览"
            android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar.OptOut" />
        <activity
            android:name=".TextLibraryActivity"
            android:label="文本库"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut"
            android:screenOrientation="portrait" />
        <activity
            android:name=".TextLibraryDetailActivity"
            android:label="文本详情"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut"
            android:screenOrientation="portrait" />

        <!-- ========== 视频 ========== -->
        <activity
            android:name=".VideoLibraryActivity"
            android:label="视频库"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut"
            android:screenOrientation="portrait" />
        <activity
            android:name=".VideoFolderDetailActivity"
            android:parentActivityName=".VideoLibraryActivity"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut"
            android:exported="false" />
        <activity
            android:name=".VideoPlayerActivityV2"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut" />

        <!-- ========== 音频 ========== -->
        <activity
            android:name=".AudioLibraryActivity"
            android:label="音频库"
            android:theme="@style/Theme.AppCompat.DayNight.DarkActionBar.OptOut" />
        <activity
            android:name=".AudioPlayerActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize"
            android:exported="false" />
        <activity
            android:name=".PlaylistDetailActivity"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar.OptOut" />

        <!-- ========== 分享接收 ========== -->
        <activity
            android:name=".ShareReceiverActivity"
            android:exported="true"
            android:theme="@style/Theme.FileServer.ShareReceiver"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- ========== FileProvider ========== -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ========== 服务 ========== -->
        <service
            android:name=".AudiobookService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="false" />
        <service
            android:name=".MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
            </intent-filter>
        </service>

        <!-- ========== 媒体按钮接收器 ========== -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>